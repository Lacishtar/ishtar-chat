{
  "name": "Lacishtar-chat",
  "version": "1.0.1",
  "author": "Lacishtar",
  "description": "Dán link YouTube Live, chọn giao diện, dán vào OBS. Xong.",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev:dashboard": "vite",
    "build:dashboard": "vite build",
    "dev": "concurrently -k \"npm:dev:dashboard\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5173 && cross-env OVS_DEV=1 electron .",
    "start": "npm run build:dashboard && electron .",
    "build": "npm run build:dashboard && electron-builder",
    "smoke:slot-style": "node scripts/smoke-test-slot-style.js",
    "smoke:decoration": "node scripts/smoke-test-decoration-config.js",
    "smoke:role-style": "node scripts/smoke-test-role-style-config.js",
    "smoke:fan-service-superchat": "node scripts/smoke-test-fan-service-superchat.js",
    "smoke:superchat-migration": "node scripts/smoke-test-superchat-migration.js",
    "smoke:fan-service-cascade": "node scripts/smoke-test-fan-service-cascade.js",
    "smoke:theme-fan-service": "node scripts/smoke-test-theme-fan-service.js",
    "smoke:danmaku": "node scripts/smoke-test-danmaku-config.js",
    "smoke:horizontal-bar": "node scripts/smoke-test-horizontal-bar-config.js",
    "smoke:chat-message": "node scripts/smoke-test-chat-message.js",
    "smoke:pool-warmup": "node scripts/smoke-test-pool-warmup.mjs",
    "smoke:pool-dynamic": "node scripts/smoke-test-pool-dynamic.mjs",
    "smoke:palette-lock": "node scripts/smoke-test-palette-lock.js",
    "smoke:credits-sections": "node scripts/smoke-test-credits-sections.js",
    "smoke:credits-theme": "node scripts/smoke-test-credits-theme.js",
    "verify:decoration-cascade": "node scripts/verify-decoration-cascade.js",
    "verify:layer-split": "node scripts/verify-layer-split.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.6",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lac.lacishtar-chat",
    "productName": "Lacishtar Chat",
    "files": [
      "main/**/*",
      "preload/**/*",
      "overlay/**/*",
      "themes/**/*",
      "shared/**/*",
      "dist-dashboard/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.ico"
    }
  }
}
